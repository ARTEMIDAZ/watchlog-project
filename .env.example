# Скопируйте этот файл в .env и впишите свои значения.

# Ключ TMDB (фильмы и сериалы). Бесплатно: https://www.themoviedb.org/settings/api
# Подходит и короткий «API Key», и длинный «API Read Access Token».
# Для аниме (Shikimori) ключ не нужен.
TMDB_API_KEY=

# Язык названий из TMDB
WATCH_LANG=ru-RU

# Только для Docker на Linux: ваш uid/gid (узнать: id -u, id -g),
# чтобы файл базы в ./data принадлежал вам. Обычно 1000.
WATCH_UID=1000
WATCH_GID=1000

# Прокси, если TMDB недоступен напрямую (по умолчанию пусто)
# WATCH_PROXY=http://host.docker.internal:8080
